{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy --strict src)",
      "Bash(uv run mypy --strict src tests)",
      "Bash(uvx ruff *)",
      "Bash(uv sync)",
      "Bash(uv sync --locked)",
      "Bash(uv sync --frozen)",
      "Bash(uv lock)",
      "Bash(uv lock --check)",
      "Bash(docker compose -f tests/integration/docker-compose.yml up -d)",
      "Bash(docker compose -f tests/integration/docker-compose.yml up -d --wait)",
      "Bash(docker compose -f tests/integration/docker-compose.yml down)",
      "Bash(docker compose -f tests/integration/docker-compose.yml down -v)",
      "Bash(docker compose -f tests/integration/docker-compose.yml ps)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff --cached)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged --stat)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)"
    ],
    "deny": [
      "Bash(git *--no-index*)",
      "Bash(git *--output*)",
      "Bash(git *--ext-diff*)",
      "Bash(git *--textconv*)",
      "Bash(uv *--python*)",
      "Bash(uv *--index*)",
      "Bash(uv *--default-index*)",
      "Bash(uv *--find-links*)",
      "Bash(uv *--project*)",
      "Bash(uv *--directory*)",
      "Read(~/.password-store/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.local/share/kwalletd/**)",
      "Read(~/Library/Keychains/**)",
      "Read(//Library/Keychains/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Roaming/Microsoft/Vault/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Vault/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",
      "Read(//mnt/*/Users/*/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(//mnt/*/Users/*/AppData/Roaming/Microsoft/Vault/**)",
      "Read(//mnt/*/Users/*/AppData/Local/Microsoft/Credentials/**)",
      "Read(//mnt/*/Users/*/AppData/Local/Microsoft/Vault/**)",
      "Read(//mnt/*/Users/*/AppData/Roaming/Microsoft/Protect/**)",
      "Read(//mnt/*/Users/*/.ssh/**)",
      "Read(//mnt/*/Users/*/.git-credentials)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.config/mailferret/**)",
      "Read(~/.local/share/mailferret/**)",
      "Read(~/Library/Application Support/mailferret/**)",
      "Read(~/AppData/Roaming/mailferret/**)",
      "Read(~/AppData/Local/mailferret/**)",
      "Read(//mnt/*/Users/*/AppData/Roaming/mailferret/**)",
      "Read(//mnt/*/Users/*/AppData/Local/mailferret/**)",
      "Edit(~/.password-store/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.config/gh/hosts.yml)",
      "Edit(~/.local/share/keyrings/**)",
      "Edit(~/.local/share/kwalletd/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(//Library/Keychains/**)",
      "Edit(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Edit(~/AppData/Roaming/Microsoft/Vault/**)",
      "Edit(~/AppData/Local/Microsoft/Credentials/**)",
      "Edit(~/AppData/Local/Microsoft/Vault/**)",
      "Edit(~/AppData/Roaming/Microsoft/Protect/**)",
      "Edit(//mnt/*/Users/*/AppData/Roaming/Microsoft/Credentials/**)",
      "Edit(//mnt/*/Users/*/AppData/Roaming/Microsoft/Vault/**)",
      "Edit(//mnt/*/Users/*/AppData/Local/Microsoft/Credentials/**)",
      "Edit(//mnt/*/Users/*/AppData/Local/Microsoft/Vault/**)",
      "Edit(//mnt/*/Users/*/AppData/Roaming/Microsoft/Protect/**)",
      "Edit(//mnt/*/Users/*/.ssh/**)",
      "Edit(//mnt/*/Users/*/.git-credentials)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(~/.config/mailferret/**)",
      "Edit(~/.local/share/mailferret/**)",
      "Edit(~/Library/Application Support/mailferret/**)",
      "Edit(~/AppData/Roaming/mailferret/**)",
      "Edit(~/AppData/Local/mailferret/**)",
      "Edit(//mnt/*/Users/*/AppData/Roaming/mailferret/**)",
      "Edit(//mnt/*/Users/*/AppData/Local/mailferret/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_fix.py"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit_guard.py",
              "all"
            ],
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
