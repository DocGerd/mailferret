#!/usr/bin/env python3
"""Git pre-commit: PII scan of the staged changes, then the tests once pyproject.toml exists.

Enable once per clone: git config core.hooksPath .githooks
Honours the optional untracked .git/info/pii-patterns via scripts/pii_check.py.
"""

import subprocess
import sys
from pathlib import Path

root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
scanner = root / "scripts" / "pii_check.py"
if not scanner.is_file():
    sys.exit("pre-commit: scripts/pii_check.py missing")

if subprocess.run([sys.executable, str(scanner), "--staged"], cwd=root, stdin=subprocess.DEVNULL).returncode != 0:
    sys.exit("pre-commit: blocked by the PII scan (see above)")

if (root / "pyproject.toml").is_file():
    try:
        rc = subprocess.run(["uv", "run", "pytest", "-q", "-x"], cwd=root, stdin=subprocess.DEVNULL).returncode
    except FileNotFoundError:
        sys.exit("pre-commit: uv not found, tests cannot run")
    if rc not in (0, 5):  # 5 = no tests collected
        sys.exit(f"pre-commit: tests failed (exit {rc})")
